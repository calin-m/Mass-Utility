{
  "$schema": "https://json.schemastore.org/agent-hooks.json",
  "version": "1.0",
  "description": "Orchestra Framework Agent Lifecycle Hooks for PreInvocation Context Priming and PreToolUse Plan Shield Enforcement",
  "hooks": {
    "PreInvocation": [
      {
        "name": "Orchestra 5-Gate Protocol & Pipeline Rules Injection",
        "type": "context_injection",
        "file": ".agents/AGENTS.md",
        "priority": "highest"
      },
      {
        "name": "Central Tools Index Registry Injection",
        "type": "context_injection",
        "file": ".bench/docs/tools_index.md",
        "priority": "high"
      }
    ],
    "PreToolUse": [
      {
        "name": "Pre-Flight Plan & Impact Analysis Verification Shield",
        "type": "command",
        "command": "python .orchestra/.conductor/tools/workspace_inspector.py verify-plan",
        "on_tool_types": [
          "write_to_file",
          "replace_file_content",
          "multi_replace_file_content"
        ]
      }
    ]
  }
}
