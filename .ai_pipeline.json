{
    "framework_version": "1.0.0",
    "directories": {
        "docs": ".bench/docs/",
        "custom_rules": ".bench/agents/custom_rules/",
        "source": "./"
    },
    "scripts": {
        "test_suite": "python .orchestra/.conductor/tools/cli_test_suite.py",
        "accessibility_linter": "python .orchestra/.conductor/tools/cli_accessibility_linter.py",
        "doctor": "python .orchestra/.conductor/tools/cli_doctor.py",
        "validate_js": "php .bench/scripts/cli_validate_js.php",
        "auto_document": "python .orchestra/.conductor/tools/cli_auto_documenter.py",
        "build": "php .bench/scripts/build_js.php",
        "map_frontend": "php .bench/scripts/generate_frontend_map.php",
        "map_architecture": "python .orchestra/.conductor/tools/generate_architecture_graph.py",
        "design_system_map": "python .orchestra/.conductor/tools/generate_design_system_map.py",
        "route_mapper": "python .orchestra/.conductor/tools/generate_route_contract_map.py",
        "component_linter": "python .orchestra/.conductor/tools/cli_componentization_linter.py",
        "security_audit": "python .orchestra/.conductor/tools/cli_security_audit.py",
        "dead_code_scanner": "python .orchestra/.conductor/tools/cli_dead_code_scanner.py",
        "api_contract_guard": "python .orchestra/.conductor/tools/cli_api_contract_guard.py",
        "architecture_linter": "python .orchestra/.conductor/tools/cli_architecture_linter.py",
        "i18n_linter": "python .orchestra/.conductor/tools/cli_i18n_linter.py",
        "sandbox_dev": "python .orchestra/.conductor/tools/cli_sandbox_runner.py",
        "sandbox_preflight": "python .orchestra/.conductor/tools/cli_sandbox_runner.py --dry-run"
    },
    "pre_commit_hooks": [
        "sandbox_preflight",
        "auto_document",
        "map_frontend",
        "map_architecture",
        "design_system_map",
        "route_mapper",
        "security_audit",
        "dead_code_scanner",
        "api_contract_guard",
        "architecture_linter",
        "i18n_linter"
    ],
    "phpstan_targets": [
        "mass_utility/src",
        "mass_utility_dashboard/src",
        "mass_utility_admin/src"
    ],
    "ignore_doc_lint_paths": [
        "mass_utility.php",
        "bin/cli_backup.php",
        "bin/cli_restore.php",
        "bin/cli_backup_worker.php",
        "bin/generate_architecture_graph.php"
    ],
    "monitored_extensions": [
        ".php",
        ".js",
        ".ts",
        ".tsx",
        ".css",
        ".tpl",
        ".md"
    ],
    "monitored_directories": [
        "src",
        "views",
        "bin",
        "mass_utility_admin/frontend/src",
        ".bench/docs",
        ".bench/agents/custom_rules",
        ".orchestra"
    ],
    "ignore_ghost_files": [
        "mass_utility_admin/frontend/postcss.config.js",
        "mass_utility_admin/frontend/tailwind.config.js",
        "mass_utility_admin/frontend/src/index.css",
        "mass_utility_dashboard/frontend/postcss.config.js",
        "mass_utility_dashboard/frontend/tailwind.config.js",
        "mass_utility_dashboard/frontend/src/index.css",
        "mass_utility/build/generate_interconnectivity_map.php",
        "mass_utility_dashboard/bin/build_js.php",
        "mass_utility_dashboard/.htaccess",
        "mass_utility_dashboard/data/.htaccess",
        "mass_utility_admin/src/.htaccess",
        "mass_utility_admin/views/templates/.htaccess",
        "mass_utility_dashboard/autoload.php",
        "mass_utility_dashboard/phpstan.neon",
        "mass_utility_dashboard/public/index.php",
        "mass_utility_dashboard/public/dev_bootstrap.php",
        "mass_utility_dashboard/tests/phpstan-bootstrap.php",
        "mass_utility/api.php",
        "mass_utility/mass_utility.php",
        "mass_utility_dashboard/views/js/mass_utility.bundle.js",
        "mass_utility_dashboard/views/js/mass_utility.js",
        "mass_utility_dashboard/frontend/src/",
        "README.md",
        "WORKSPACE.md",
        "GEMINI.md",
        ".ai_plan.md",
        "mass_utility/bin/test_license_encryption.php",
        "mass_utility_dashboard/bin/migration.php",
        "mass_utility_dashboard/src/Controller/Api/LicenseVerifyController.php",
        "mass_utility_admin/public/index.php",
        "mass_utility_admin/src/Controller/AdminApiController.php",
        "mass_utility_admin/src/Repository/LicenseRepository.php",
        "mass_utility_admin/src/Service/AdminSettingsManager.php",
        "mass_utility_admin/views/css/admin.css",
        "mass_utility_admin/views/js/AdminEngine.js",
        "mass_utility_admin/.htaccess"
    ],
    "health_audit_log": ".bench/docs/audits/active_audit.md",
    "legacy_coupling_targets": [
        "mass_utility_dashboard/src",
        "mass_utility_dashboard/views"
    ],
    "legacy_coupling_patterns": {
        "Db::getInstance": "Legacy MariaDB connection",
        "ObjectModel": "Legacy ActiveRecord model class",
        "Context::getContext": "Legacy Global Context dependency",
        "Configuration::get": "Legacy PrestaShop Config usage"
    },
    "oop_namespaces": {
        "MassUtility\\SaaS\\": "mass_utility_dashboard/src/",
        "MassUtilityAdmin\\": "mass_utility_admin/src/",
        "MassUtility\\": "mass_utility/src/"
    },
    "architecture_graphs": [
        {
            "namespace": "MassUtility\\Dashboard",
            "source": "mass_utility_dashboard/src/",
            "output": ".bench/docs/dashboard/architecture/00_auto_generated_oop_map.md"
        },
        {
            "namespace": "MassUtilityAdmin",
            "source": "mass_utility_admin/src/",
            "output": ".bench/docs/admin/architecture/00_auto_generated_oop_map.md"
        },
        {
            "namespace": "MassUtility",
            "source": "mass_utility/src/",
            "output": ".bench/docs/bridge/architecture/00_auto_generated_oop_map.md"
        }
    ],
    "language_syntax": {
        ".js": {
            "comment": "//"
        },
        ".php": {
            "comment": "//"
        },
        ".py": {
            "comment": "#"
        },
        ".css": {
            "comment": "/*"
        },
        ".tpl": {
            "comment": "{*"
        }
    },
    "dictionary_mappings": {
        "Bridge_OOP_Map": ".bench/docs/bridge/architecture/00_auto_generated_oop_map.md",
        "Bridge_Pipeline": ".bench/docs/bridge/architecture/01_backend_pipeline.md",
        "Bridge_Integration": ".bench/docs/bridge/architecture/02_integration_matrix.md",
        "Bridge_Settings": ".bench/docs/bridge/architecture/08_settings_contract_map.md",
        "Dashboard_OOP_Map": ".bench/docs/dashboard/architecture/00_auto_generated_oop_map.md",
        "Dashboard_Pipeline": ".bench/docs/dashboard/architecture/01_backend_pipeline.md",
        "Dashboard_Interconnectivity": ".bench/docs/dashboard/architecture/02_interconnectivity_map.md",
        "Dashboard_Engine_Capabilities": ".bench/docs/dashboard/architecture/07_engine_capabilities_map.md",
        "Frontend_Map": ".bench/docs/dashboard/frontend/00_auto_generated_frontend_map.md",
        "UI_Components": ".bench/docs/dashboard/frontend/01_ui_component_map.md",
        "DOM_Modals": ".bench/docs/dashboard/frontend/02_dom_and_modals_map.md",
        "JS_Engine": ".bench/docs/dashboard/frontend/03_javascript_engine_map.md",
        "CSS_Tokens": ".bench/docs/dashboard/frontend/04_css_tokens_map.md",
        "FetchService": ".bench/docs/dashboard/frontend/03_javascript_engine_map.md",
        "V2_React_Component_Map": ".bench/docs/dashboard/frontend/05_v2_react_component_map.md",
        "Database_Schema_Map": ".bench/docs/dashboard/architecture/05_database_schema_map.md",
        "Admin_OOP_Map": ".bench/docs/admin/architecture/00_auto_generated_oop_map.md",
        "Admin_i18n_Locales": ".bench/docs/admin/architecture/06_i18n_localization_map.md",
        "Tag": ".bench/docs/dashboard/frontend/01_ui_component_map.md",
        "Utils": ".bench/docs/dashboard/frontend/03_javascript_engine_map.md"
    },
    "doc_lint_targets": {
        "Bridge Module": {
            "docs_dir": ".bench/docs/bridge",
            "module_dir": "mass_utility"
        },
        "SaaS Dashboard": {
            "docs_dir": ".bench/docs/dashboard",
            "module_dir": "mass_utility_dashboard"
        },
        "Admin Module": {
            "docs_dir": ".bench/docs/admin",
            "module_dir": "mass_utility_admin"
        }
    },
    "trace_patterns": [
        {
            "language": "js",
            "regex": "FetchEngine\\.(?:post|get)\\('(?P<action>[a-zA-Z0-9_]+)'\\)"
        },
        {
            "language": "php",
            "regex": "\\$action\\s*===\\s*'(?P<action>[a-zA-Z0-9_]+)'"
        }
    ]
}