# Ignore everything by default
/*

# Whitelist allowed directories
!/mass_utility/
!/mass_utility_dashboard/
!/mass_utility_admin/

# Whitelist allowed files
!/.cpanel.yml
!/README.md
!/.gitignore

# Ignore build and runtime junk inside whitelisted folders
**/__pycache__/
**/*.pyc
**/.sandbox/*.sqlite
**/backups/
**/logs/*.log
**/*.db
**/data/

# Ignore JIT cache databases and tools inside .bench
.bench/sandbox/
.bench/db/
.bench/tools_registry.json
